# Docker Compose / PostgreSQL
POSTGRES_DB=geniusquest
POSTGRES_USER=geniusquest
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_PORT=5432

# Spring Boot (quando executar fora do Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geniusquest
DB_USER=geniusquest
DB_PASSWORD=troque_esta_senha
SERVER_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Brevo: login SMTP e chave SMTP (nao a chave de API).
# Render Free bloqueia 25/465/587; Brevo aceita SMTP STARTTLS na porta 2525.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
# Em desenvolvimento com Mailpit sem STARTTLS: configure ambos como false SOMENTE no ambiente local.
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
MAIL_USER=
MAIL_PASS=
# Endereco de remetente verificado na Brevo.
MAIL_FROM=
FRONTEND_URL=http://localhost:5173
